{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:postware:crm:deal",
  "title": "Deal",
  "description": "A potential sale to an Organization or a Person, tracked through a Pipeline, with an amount, a probability and an expected close. Won or lost is the status category.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID; generated when absent"
    },
    "model": {
      "type": "string",
      "description": "name@version",
      "readOnly": true
    },
    "workspace": {
      "type": "string",
      "description": "the Workspace record id",
      "readOnly": true
    },
    "revision": {
      "type": "integer",
      "description": "optimistic concurrency with If-Match",
      "readOnly": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "created_by": {
      "$ref": "#/$defs/Principal",
      "description": "{kind: member|person|share|system, id}",
      "readOnly": true
    },
    "updated_by": {
      "$ref": "#/$defs/Principal",
      "description": "{kind, id}",
      "readOnly": true
    },
    "owner": {
      "type": "string",
      "description": "Member id, the accountable operator"
    },
    "identifiers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Identifier"
      },
      "description": "Identifier[]: the crosswalk"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z0-9][a-z0-9_-]{0,63}:)?[a-z0-9][a-z0-9_-]{0,63}(/[a-z0-9][a-z0-9_-]{0,63})*$"
      },
      "description": "tag slugs, `namespace:slug` form"
    },
    "ext": {
      "type": "object",
      "description": "declared extensions only"
    },
    "source": {
      "type": "object",
      "description": "{system, external_id, created_at, updated_at, deleted_at?, import_run, imported_at, payload}"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "soft delete",
      "readOnly": true
    },
    "name": {
      "type": "string",
      "maxLength": 4000
    },
    "organization": {
      "$ref": "#/$defs/Ref",
      "x-to": [
        "organization"
      ]
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "person": {
            "$ref": "#/$defs/Ref",
            "x-to": [
              "person"
            ]
          },
          "primary": {
            "type": "boolean"
          },
          "role": {
            "type": "string",
            "maxLength": 4000,
            "description": "e.g. decision maker, billing contact"
          }
        },
        "required": [
          "person"
        ],
        "additionalProperties": false
      }
    },
    "pipeline": {
      "$ref": "#/$defs/Ref",
      "x-to": [
        "pipeline"
      ]
    },
    "stage": {
      "type": "string",
      "maxLength": 4000,
      "description": "a stage key of the pipeline"
    },
    "status": {
      "$ref": "#/$defs/Status",
      "x-categories": [
        "open",
        "won",
        "lost"
      ],
      "description": "category defaults from the stage's category",
      "default": {
        "category": "open"
      }
    },
    "amount": {
      "$ref": "#/$defs/Money"
    },
    "probability": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "description": "0 to 1; defaults from the stage"
    },
    "expected_close": {
      "type": "string",
      "format": "date"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time",
      "description": "set when status.category leaves open"
    },
    "description": {
      "type": "string",
      "contentMediaType": "text/markdown"
    }
  },
  "required": [
    "id",
    "model",
    "workspace",
    "revision",
    "created_at",
    "updated_at",
    "created_by",
    "updated_by",
    "name",
    "pipeline",
    "stage",
    "status"
  ],
  "additionalProperties": false,
  "x-model": {
    "name": "deal",
    "version": 1,
    "group": "crm",
    "identity": [
      [
        "identifiers"
      ]
    ],
    "status_categories": [
      "open",
      "won",
      "lost"
    ],
    "sensitivity": {},
    "events": [
      {
        "field": "status.category",
        "to": "won",
        "name": "deal.won"
      },
      {
        "field": "status.category",
        "to": "lost",
        "name": "deal.lost"
      }
    ],
    "agent_context": "Deal is the opportunity, not the customer: the customer is the Organization or Person it points at. Set stage\nto a key of its Pipeline; status.category follows that stage's category unless you set it (a deal can be lost\nfrom any stage), and won emits deal.won. people[] holds the contacts on the deal, one marked primary. Dedupe by\nidentifier only, so query open Deals for the same Organization before creating one. The one mistake: products,\nquantities and prices on the Deal; they belong on the quote or the Invoice."
  },
  "$defs": {
    "Ref": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "model",
        "id"
      ],
      "additionalProperties": false
    },
    "Principal": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "member",
            "person",
            "share",
            "system"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    "Identifier": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "maxLength": 4000
        },
        "value": {
          "type": "string",
          "maxLength": 4000
        },
        "primary": {
          "type": "boolean"
        }
      },
      "required": [
        "system",
        "value"
      ],
      "additionalProperties": false,
      "description": "An external or natural key. `system` is a registered scheme (email, domain, vat:eu, sha256, stripe:customer, postware:workspace)."
    },
    "Money": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "currency": {
          "type": "string",
          "maxLength": 4000,
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    },
    "Status": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "maxLength": 4000
        },
        "state": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "category"
      ],
      "additionalProperties": false,
      "description": "category is the standard (validated per model); state is the workspace's own label."
    }
  }
}