{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:postware:core:organization",
  "title": "Organization",
  "description": "A company, nonprofit, government body or household: a customer, a vendor, a partner or an account. The relationship to the workspace lives on Deals, Invoices, affiliations and tags, never on the Organization.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID; generated when absent"
    },
    "model": {
      "type": "string",
      "description": "name@version",
      "readOnly": true
    },
    "workspace": {
      "type": "string",
      "description": "the Workspace record id",
      "readOnly": true
    },
    "revision": {
      "type": "integer",
      "description": "optimistic concurrency with If-Match",
      "readOnly": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "created_by": {
      "$ref": "#/$defs/Principal",
      "description": "{kind: member|person|share|system, id}",
      "readOnly": true
    },
    "updated_by": {
      "$ref": "#/$defs/Principal",
      "description": "{kind, id}",
      "readOnly": true
    },
    "owner": {
      "type": "string",
      "description": "Member id, the accountable operator"
    },
    "identifiers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Identifier"
      },
      "description": "Identifier[]: the crosswalk"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z0-9][a-z0-9_-]{0,63}:)?[a-z0-9][a-z0-9_-]{0,63}(/[a-z0-9][a-z0-9_-]{0,63})*$"
      },
      "description": "tag slugs, `namespace:slug` form"
    },
    "ext": {
      "type": "object",
      "description": "declared extensions only"
    },
    "source": {
      "type": "object",
      "description": "{system, external_id, created_at, updated_at, deleted_at?, import_run, imported_at, payload}"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "soft delete",
      "readOnly": true
    },
    "name": {
      "type": "string",
      "maxLength": 4000
    },
    "phones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ContactPoint"
      }
    },
    "urls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ContactPoint"
      },
      "description": "website first; social profiles after"
    },
    "addresses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Address"
      },
      "description": "kind billing, shipping, mailing, work or other"
    },
    "parent": {
      "$ref": "#/$defs/Ref",
      "x-to": [
        "organization"
      ]
    },
    "logo": {
      "$ref": "#/$defs/Ref",
      "x-to": [
        "file"
      ]
    },
    "description": {
      "type": "string",
      "contentMediaType": "text/markdown"
    }
  },
  "required": [
    "id",
    "model",
    "workspace",
    "revision",
    "created_at",
    "updated_at",
    "created_by",
    "updated_by",
    "name"
  ],
  "additionalProperties": false,
  "x-model": {
    "name": "organization",
    "version": 1,
    "group": "core",
    "identity": [
      [
        "identifiers"
      ]
    ],
    "status_categories": [],
    "sensitivity": {},
    "events": null,
    "agent_context": "Use Organization for any company or institution. Dedupe by the domain identifier (identifiers [{system: domain,\nvalue: ...}]); derive the domain from a website URL before creating, and add vat:*, duns or lei identifiers when\nknown. Firmographics (industry, employees, annual revenue) are ext.crm.*, the registered name for invoices is\next.billing.legal_name, and the relationship (customer, partner, vendor) is a tag. The one mistake: a second\nOrganization for the same company under another spelling of its name."
  },
  "$defs": {
    "Ref": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "model",
        "id"
      ],
      "additionalProperties": false
    },
    "Principal": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "member",
            "person",
            "share",
            "system"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    "Address": {
      "type": "object",
      "properties": {
        "lines": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "locality": {
          "type": "string",
          "maxLength": 4000
        },
        "region": {
          "type": "string",
          "maxLength": 4000
        },
        "postal_code": {
          "type": "string",
          "maxLength": 4000
        },
        "country": {
          "type": "string",
          "maxLength": 4000,
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2"
        },
        "kind": {
          "type": "string",
          "enum": [
            "billing",
            "shipping",
            "mailing",
            "home",
            "work",
            "other"
          ]
        },
        "primary": {
          "type": "boolean"
        },
        "geo": {
          "type": "object",
          "properties": {
            "lat": {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            },
            "lon": {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            }
          },
          "required": [
            "lat",
            "lon"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "lines",
        "country"
      ],
      "additionalProperties": false
    },
    "ContactPoint": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "maxLength": 4000
        },
        "label": {
          "type": "string",
          "enum": [
            "work",
            "home",
            "mobile",
            "fax",
            "billing",
            "other"
          ]
        },
        "primary": {
          "type": "boolean"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false,
      "description": "One email, phone or URL; used by the emails[], phones[] and urls[] arrays."
    },
    "Identifier": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "maxLength": 4000
        },
        "value": {
          "type": "string",
          "maxLength": 4000
        },
        "primary": {
          "type": "boolean"
        }
      },
      "required": [
        "system",
        "value"
      ],
      "additionalProperties": false,
      "description": "An external or natural key. `system` is a registered scheme (email, domain, vat:eu, sha256, stripe:customer, postware:workspace)."
    }
  }
}