{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:postware:system:tag",
  "title": "Tag",
  "description": "A label that works the same on every record: a namespaced slug with a display name, a colour and a description. The envelope's tags[] holds slugs that resolve to Tag records.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID; generated when absent"
    },
    "model": {
      "type": "string",
      "description": "name@version",
      "readOnly": true
    },
    "workspace": {
      "type": "string",
      "description": "the Workspace record id",
      "readOnly": true
    },
    "revision": {
      "type": "integer",
      "description": "optimistic concurrency with If-Match",
      "readOnly": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "created_by": {
      "$ref": "#/$defs/Principal",
      "description": "{kind: member|person|share|system, id}",
      "readOnly": true
    },
    "updated_by": {
      "$ref": "#/$defs/Principal",
      "description": "{kind, id}",
      "readOnly": true
    },
    "owner": {
      "type": "string",
      "description": "Member id, the accountable operator"
    },
    "identifiers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Identifier"
      },
      "description": "Identifier[]: the crosswalk"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z0-9][a-z0-9_-]{0,63}:)?[a-z0-9][a-z0-9_-]{0,63}(/[a-z0-9][a-z0-9_-]{0,63})*$"
      },
      "description": "tag slugs, `namespace:slug` form"
    },
    "ext": {
      "type": "object",
      "description": "declared extensions only"
    },
    "source": {
      "type": "object",
      "description": "{system, external_id, created_at, updated_at, deleted_at?, import_run, imported_at, payload}"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "soft delete",
      "readOnly": true
    },
    "name": {
      "type": "string",
      "maxLength": 4000,
      "description": "the display form; may carry case and spaces"
    },
    "slug": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}(?:/[a-z0-9][a-z0-9_-]{0,63})*$",
      "description": "lowercase segments joined by /"
    },
    "namespace": {
      "type": "string",
      "maxLength": 4000,
      "pattern": "^[a-z][a-z0-9-]{0,31}$",
      "description": "none = workspace-local; sys, a pack name and a source name are reserved"
    },
    "color": {
      "type": "string",
      "maxLength": 4000,
      "pattern": "^#[0-9a-fA-F]{6}$",
      "description": "#RRGGBB"
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "applies_to": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000
      },
      "description": "model names this tag is meant for; absent means any"
    }
  },
  "required": [
    "id",
    "model",
    "workspace",
    "revision",
    "created_at",
    "updated_at",
    "created_by",
    "updated_by",
    "name",
    "slug"
  ],
  "additionalProperties": false,
  "x-model": {
    "name": "tag",
    "version": 1,
    "group": "system",
    "identity": [
      [
        "namespace",
        "slug"
      ]
    ],
    "status_categories": [],
    "sensitivity": {},
    "events": null,
    "agent_context": "Tags classify; they never carry meaning the standard depends on (that is a field or a Status). Write slugs in\ntags[] on any record and missing workspace tags are created for you; create a Tag record only to set a colour or\na description. A slug is [namespace:]segment(/segment)*, each segment [a-z0-9][a-z0-9_-]{0,63}, at most 255\ncharacters, compared case-insensitively; name is the display form. Dedupe by (namespace, slug). The one mistake:\nwriting into a reserved namespace (sys, a pack name, a source name); those belong to the server, packs and importers."
  },
  "$defs": {
    "Ref": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "model",
        "id"
      ],
      "additionalProperties": false
    },
    "Principal": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "member",
            "person",
            "share",
            "system"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    "Identifier": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "maxLength": 4000
        },
        "value": {
          "type": "string",
          "maxLength": 4000
        },
        "primary": {
          "type": "boolean"
        }
      },
      "required": [
        "system",
        "value"
      ],
      "additionalProperties": false,
      "description": "An external or natural key. `system` is a registered scheme (email, domain, vat:eu, sha256, stripe:customer, postware:workspace)."
    }
  }
}