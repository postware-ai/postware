{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:postware:billing:payment",
  "title": "Payment",
  "description": "Money that moved against invoices: a customer paying us (receivable), us paying a vendor (payable), or a refund of either.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID; generated when absent"
    },
    "model": {
      "type": "string",
      "description": "name@version",
      "readOnly": true
    },
    "workspace": {
      "type": "string",
      "description": "the Workspace record id",
      "readOnly": true
    },
    "revision": {
      "type": "integer",
      "description": "optimistic concurrency with If-Match",
      "readOnly": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "created_by": {
      "$ref": "#/$defs/Principal",
      "description": "{kind: member|person|share|system, id}",
      "readOnly": true
    },
    "updated_by": {
      "$ref": "#/$defs/Principal",
      "description": "{kind, id}",
      "readOnly": true
    },
    "owner": {
      "type": "string",
      "description": "Member id, the accountable operator"
    },
    "identifiers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Identifier"
      },
      "description": "Identifier[]: the crosswalk"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z0-9][a-z0-9_-]{0,63}:)?[a-z0-9][a-z0-9_-]{0,63}(/[a-z0-9][a-z0-9_-]{0,63})*$"
      },
      "description": "tag slugs, `namespace:slug` form"
    },
    "ext": {
      "type": "object",
      "description": "declared extensions only"
    },
    "source": {
      "type": "object",
      "description": "{system, external_id, created_at, updated_at, deleted_at?, import_run, imported_at, payload}"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "soft delete",
      "readOnly": true
    },
    "direction": {
      "type": "string",
      "enum": [
        "receivable",
        "payable"
      ],
      "default": "receivable"
    },
    "kind": {
      "type": "string",
      "enum": [
        "payment",
        "refund"
      ],
      "default": "payment"
    },
    "counterparty": {
      "$ref": "#/$defs/Ref",
      "x-to": [
        "organization",
        "person"
      ]
    },
    "amount": {
      "$ref": "#/$defs/Money"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "method": {
      "type": "string",
      "enum": [
        "card",
        "bank_transfer",
        "direct_debit",
        "cash",
        "check",
        "wallet",
        "other"
      ]
    },
    "status": {
      "$ref": "#/$defs/Status",
      "x-categories": [
        "pending",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "default": {
        "category": "succeeded"
      }
    },
    "applied": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "invoice": {
            "$ref": "#/$defs/Ref",
            "x-to": [
              "invoice"
            ]
          },
          "amount": {
            "$ref": "#/$defs/Money"
          }
        },
        "required": [
          "invoice",
          "amount"
        ],
        "additionalProperties": false
      }
    },
    "refund_of": {
      "$ref": "#/$defs/Ref",
      "x-to": [
        "payment"
      ]
    },
    "reference": {
      "type": "string",
      "maxLength": 4000,
      "description": "check number, bank reference, processor id or remittance text"
    }
  },
  "required": [
    "id",
    "model",
    "workspace",
    "revision",
    "created_at",
    "updated_at",
    "created_by",
    "updated_by",
    "direction",
    "kind",
    "counterparty",
    "amount",
    "paid_at",
    "status"
  ],
  "additionalProperties": false,
  "x-model": {
    "name": "payment",
    "version": 1,
    "group": "billing",
    "identity": [
      [
        "identifiers"
      ]
    ],
    "status_categories": [
      "pending",
      "succeeded",
      "failed",
      "cancelled"
    ],
    "sensitivity": {},
    "events": [
      {
        "field": "status.category",
        "to": "succeeded",
        "name": "payment.succeeded"
      },
      {
        "field": "status.category",
        "to": "failed",
        "name": "payment.failed"
      }
    ],
    "agent_context": "direction is the ledger side; kind says whether money went the normal way (payment) or back (refund, with\nrefund_of pointing at the original). applied[] says which Invoices this payment settles and by how much; update\ntheir amount_paid and status yourself. Payments recorded from accounting systems are succeeded; processor payments\ncarry pending, failed or cancelled. Dedupe by identifier (the processor's or ledger's id). The one mistake: a\nrefund as a negative amount; record a Payment of kind refund."
  },
  "$defs": {
    "Ref": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "model",
        "id"
      ],
      "additionalProperties": false
    },
    "Principal": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "member",
            "person",
            "share",
            "system"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    "Identifier": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "maxLength": 4000
        },
        "value": {
          "type": "string",
          "maxLength": 4000
        },
        "primary": {
          "type": "boolean"
        }
      },
      "required": [
        "system",
        "value"
      ],
      "additionalProperties": false,
      "description": "An external or natural key. `system` is a registered scheme (email, domain, vat:eu, sha256, stripe:customer, postware:workspace)."
    },
    "Money": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "currency": {
          "type": "string",
          "maxLength": 4000,
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    },
    "Status": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "maxLength": 4000
        },
        "state": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "category"
      ],
      "additionalProperties": false,
      "description": "category is the standard (validated per model); state is the workspace's own label."
    }
  }
}