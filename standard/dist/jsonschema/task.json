{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:postware:core:task",
  "title": "Task",
  "description": "A unit of work with a status, a priority, assignees and a due date. It nests under a parent Task and belongs to one Project.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID; generated when absent"
    },
    "model": {
      "type": "string",
      "description": "name@version",
      "readOnly": true
    },
    "workspace": {
      "type": "string",
      "description": "the Workspace record id",
      "readOnly": true
    },
    "revision": {
      "type": "integer",
      "description": "optimistic concurrency with If-Match",
      "readOnly": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "created_by": {
      "$ref": "#/$defs/Principal",
      "description": "{kind: member|person|share|system, id}",
      "readOnly": true
    },
    "updated_by": {
      "$ref": "#/$defs/Principal",
      "description": "{kind, id}",
      "readOnly": true
    },
    "owner": {
      "type": "string",
      "description": "Member id, the accountable operator"
    },
    "identifiers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Identifier"
      },
      "description": "Identifier[]: the crosswalk"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z0-9][a-z0-9_-]{0,63}:)?[a-z0-9][a-z0-9_-]{0,63}(/[a-z0-9][a-z0-9_-]{0,63})*$"
      },
      "description": "tag slugs, `namespace:slug` form"
    },
    "ext": {
      "type": "object",
      "description": "declared extensions only"
    },
    "source": {
      "type": "object",
      "description": "{system, external_id, created_at, updated_at, deleted_at?, import_run, imported_at, payload}"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "soft delete",
      "readOnly": true
    },
    "title": {
      "type": "string",
      "maxLength": 4000
    },
    "description": {
      "type": "string",
      "contentMediaType": "text/markdown"
    },
    "status": {
      "$ref": "#/$defs/Status",
      "x-categories": [
        "open",
        "in_progress",
        "done",
        "cancelled"
      ],
      "default": {
        "category": "open"
      }
    },
    "priority": {
      "type": "string",
      "enum": [
        "urgent",
        "high",
        "normal",
        "low"
      ]
    },
    "assignees": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Ref",
        "x-to": [
          "member"
        ]
      }
    },
    "due_on": {
      "type": "string",
      "format": "date"
    },
    "due_at": {
      "type": "string",
      "format": "date-time",
      "description": "set only when the source has a time of day"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "parent": {
      "$ref": "#/$defs/Ref",
      "x-to": [
        "task"
      ]
    },
    "project": {
      "$ref": "#/$defs/Ref",
      "x-to": [
        "project"
      ]
    },
    "about": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Ref"
      }
    }
  },
  "required": [
    "id",
    "model",
    "workspace",
    "revision",
    "created_at",
    "updated_at",
    "created_by",
    "updated_by",
    "title",
    "status"
  ],
  "additionalProperties": false,
  "x-model": {
    "name": "task",
    "version": 1,
    "group": "core",
    "identity": [
      [
        "identifiers"
      ]
    ],
    "status_categories": [
      "open",
      "in_progress",
      "done",
      "cancelled"
    ],
    "sensitivity": {},
    "events": [
      {
        "field": "status.category",
        "to": "done",
        "name": "task.completed"
      }
    ],
    "agent_context": "Task is work someone has to do; a reminder at a time is an Event, a request from a customer is a Ticket. Use\ndue_on for a date and due_at only when the source has a time of day. Blocked is a state label under open or\nin_progress, not a category. Dedupe by identifier only, so search open Tasks by title before creating one.\nThe one mistake: setting status.category to done without completed_at; set both."
  },
  "$defs": {
    "Ref": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "model",
        "id"
      ],
      "additionalProperties": false
    },
    "Principal": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "member",
            "person",
            "share",
            "system"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    "Identifier": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "maxLength": 4000
        },
        "value": {
          "type": "string",
          "maxLength": 4000
        },
        "primary": {
          "type": "boolean"
        }
      },
      "required": [
        "system",
        "value"
      ],
      "additionalProperties": false,
      "description": "An external or natural key. `system` is a registered scheme (email, domain, vat:eu, sha256, stripe:customer, postware:workspace)."
    },
    "Status": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "maxLength": 4000
        },
        "state": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "category"
      ],
      "additionalProperties": false,
      "description": "category is the standard (validated per model); state is the workspace's own label."
    }
  }
}