{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:postware:crm:pipeline",
  "title": "Pipeline",
  "description": "An ordered set of stages that Deals move through, each mapped to one of the standard categories open, won or lost. A workspace has one default pipeline.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID; generated when absent"
    },
    "model": {
      "type": "string",
      "description": "name@version",
      "readOnly": true
    },
    "workspace": {
      "type": "string",
      "description": "the Workspace record id",
      "readOnly": true
    },
    "revision": {
      "type": "integer",
      "description": "optimistic concurrency with If-Match",
      "readOnly": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "created_by": {
      "$ref": "#/$defs/Principal",
      "description": "{kind: member|person|share|system, id}",
      "readOnly": true
    },
    "updated_by": {
      "$ref": "#/$defs/Principal",
      "description": "{kind, id}",
      "readOnly": true
    },
    "owner": {
      "type": "string",
      "description": "Member id, the accountable operator"
    },
    "identifiers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Identifier"
      },
      "description": "Identifier[]: the crosswalk"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z0-9][a-z0-9_-]{0,63}:)?[a-z0-9][a-z0-9_-]{0,63}(/[a-z0-9][a-z0-9_-]{0,63})*$"
      },
      "description": "tag slugs, `namespace:slug` form"
    },
    "ext": {
      "type": "object",
      "description": "declared extensions only"
    },
    "source": {
      "type": "object",
      "description": "{system, external_id, created_at, updated_at, deleted_at?, import_run, imported_at, payload}"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "soft delete",
      "readOnly": true
    },
    "name": {
      "type": "string",
      "maxLength": 4000
    },
    "default": {
      "type": "boolean",
      "description": "the pipeline new Deals go to when none is given",
      "default": false
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 4000,
            "description": "stable, snake_case; referenced by Deal.stage"
          },
          "label": {
            "type": "string",
            "maxLength": 4000
          },
          "category": {
            "type": "string",
            "enum": [
              "open",
              "won",
              "lost"
            ]
          },
          "order": {
            "type": "integer"
          },
          "probability": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
            "description": "0 to 1; the default for Deal.probability"
          },
          "archived": {
            "type": "boolean",
            "description": "retired; kept because Deals still reference it"
          }
        },
        "required": [
          "key",
          "label",
          "category",
          "order"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "model",
    "workspace",
    "revision",
    "created_at",
    "updated_at",
    "created_by",
    "updated_by",
    "name",
    "stages"
  ],
  "additionalProperties": false,
  "x-model": {
    "name": "pipeline",
    "version": 1,
    "group": "crm",
    "identity": [
      [
        "name"
      ]
    ],
    "status_categories": [],
    "sensitivity": {},
    "events": null,
    "agent_context": "Read the default pipeline before creating a Deal and use one of its stage keys; Deal.pipeline is required and\nthe default pipeline is used when you omit it. Every pipeline holds at least one open, one won and one lost\nstage. Dedupe by name. The one mistake: deleting or re-keying a stage that Deals reference; set archived true\nand keep the key."
  },
  "$defs": {
    "Ref": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "model",
        "id"
      ],
      "additionalProperties": false
    },
    "Principal": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "member",
            "person",
            "share",
            "system"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    "Identifier": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "maxLength": 4000
        },
        "value": {
          "type": "string",
          "maxLength": 4000
        },
        "primary": {
          "type": "boolean"
        }
      },
      "required": [
        "system",
        "value"
      ],
      "additionalProperties": false,
      "description": "An external or natural key. `system` is a registered scheme (email, domain, vat:eu, sha256, stripe:customer, postware:workspace)."
    }
  }
}