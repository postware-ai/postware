{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:postware:system:identity",
  "title": "Identity",
  "description": "How a principal authenticates: a provider's stable subject bound to a Member (an operator) or a Person (an end user), with the asserted email and the kinds of factor used. Credential material lives in the auth store, never here.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID; generated when absent"
    },
    "model": {
      "type": "string",
      "description": "name@version",
      "readOnly": true
    },
    "workspace": {
      "type": "string",
      "description": "the Workspace record id",
      "readOnly": true
    },
    "revision": {
      "type": "integer",
      "description": "optimistic concurrency with If-Match",
      "readOnly": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "created_by": {
      "$ref": "#/$defs/Principal",
      "description": "{kind: member|person|share|system, id}",
      "readOnly": true
    },
    "updated_by": {
      "$ref": "#/$defs/Principal",
      "description": "{kind, id}",
      "readOnly": true
    },
    "owner": {
      "type": "string",
      "description": "Member id, the accountable operator"
    },
    "identifiers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Identifier"
      },
      "description": "Identifier[]: the crosswalk"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z0-9][a-z0-9_-]{0,63}:)?[a-z0-9][a-z0-9_-]{0,63}(/[a-z0-9][a-z0-9_-]{0,63})*$"
      },
      "description": "tag slugs, `namespace:slug` form"
    },
    "ext": {
      "type": "object",
      "description": "declared extensions only"
    },
    "source": {
      "type": "object",
      "description": "{system, external_id, created_at, updated_at, deleted_at?, import_run, imported_at, payload}"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "soft delete",
      "readOnly": true
    },
    "principal": {
      "$ref": "#/$defs/Ref",
      "x-to": [
        "member",
        "person"
      ],
      "description": "operator or end user"
    },
    "provider": {
      "type": "string",
      "maxLength": 4000,
      "description": "builtin, or the issuer URL of an external provider"
    },
    "subject": {
      "type": "string",
      "maxLength": 4000,
      "description": "the provider's stable id (OIDC sub)"
    },
    "email": {
      "type": "string",
      "maxLength": 4000,
      "description": "the address this login asserts; never a key"
    },
    "email_verified": {
      "type": "boolean",
      "default": false
    },
    "factors": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "magic_link",
          "password",
          "passkey",
          "totp",
          "sms",
          "oauth",
          "saml",
          "api_key"
        ]
      },
      "description": "the kinds of credential used; device and enrolment details live in the auth store",
      "default": []
    },
    "claims": {
      "type": "object",
      "additionalProperties": true,
      "description": "mapped provider claims; never tokens"
    },
    "status": {
      "$ref": "#/$defs/Status",
      "x-categories": [
        "active",
        "disabled"
      ],
      "default": {
        "category": "active"
      }
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time",
      "description": "touched at most once an hour; drives the monthly active user count"
    }
  },
  "required": [
    "id",
    "model",
    "workspace",
    "revision",
    "created_at",
    "updated_at",
    "created_by",
    "updated_by",
    "principal",
    "provider",
    "subject",
    "email_verified",
    "factors",
    "status"
  ],
  "additionalProperties": false,
  "x-model": {
    "name": "identity",
    "version": 1,
    "group": "system",
    "identity": [
      [
        "provider",
        "subject"
      ]
    ],
    "status_categories": [
      "active",
      "disabled"
    ],
    "sensitivity": {
      "claims": "confidential"
    },
    "events": null,
    "agent_context": "Identity is written by the auth component when someone signs in; you never create or edit one. A Person with an\nIdentity is an end user. Dedupe by (provider, subject); an email is never an Identity key, only a Person one.\nThe one mistake: looking for passwords or tokens here; credentials are never stored on records."
  },
  "$defs": {
    "Ref": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "model",
        "id"
      ],
      "additionalProperties": false
    },
    "Principal": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "member",
            "person",
            "share",
            "system"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    "Identifier": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "maxLength": 4000
        },
        "value": {
          "type": "string",
          "maxLength": 4000
        },
        "primary": {
          "type": "boolean"
        }
      },
      "required": [
        "system",
        "value"
      ],
      "additionalProperties": false,
      "description": "An external or natural key. `system` is a registered scheme (email, domain, vat:eu, sha256, stripe:customer, postware:workspace)."
    },
    "Status": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "maxLength": 4000
        },
        "state": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "category"
      ],
      "additionalProperties": false,
      "description": "category is the standard (validated per model); state is the workspace's own label."
    }
  }
}