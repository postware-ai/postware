{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:postware:support:ticket",
  "title": "Ticket",
  "description": "A request for help from a Person, owned by the team until it is solved. The conversation is Messages about it; internal notes are Notes about it.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID; generated when absent"
    },
    "model": {
      "type": "string",
      "description": "name@version",
      "readOnly": true
    },
    "workspace": {
      "type": "string",
      "description": "the Workspace record id",
      "readOnly": true
    },
    "revision": {
      "type": "integer",
      "description": "optimistic concurrency with If-Match",
      "readOnly": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "created_by": {
      "$ref": "#/$defs/Principal",
      "description": "{kind: member|person|share|system, id}",
      "readOnly": true
    },
    "updated_by": {
      "$ref": "#/$defs/Principal",
      "description": "{kind, id}",
      "readOnly": true
    },
    "owner": {
      "type": "string",
      "description": "Member id, the accountable operator"
    },
    "identifiers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Identifier"
      },
      "description": "Identifier[]: the crosswalk"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z0-9][a-z0-9_-]{0,63}:)?[a-z0-9][a-z0-9_-]{0,63}(/[a-z0-9][a-z0-9_-]{0,63})*$"
      },
      "description": "tag slugs, `namespace:slug` form"
    },
    "ext": {
      "type": "object",
      "description": "declared extensions only"
    },
    "source": {
      "type": "object",
      "description": "{system, external_id, created_at, updated_at, deleted_at?, import_run, imported_at, payload}"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "soft delete",
      "readOnly": true
    },
    "subject": {
      "type": "string",
      "maxLength": 4000
    },
    "description": {
      "type": "string",
      "contentMediaType": "text/markdown",
      "description": "the request as written; importers copy the first inbound message when the source has no description"
    },
    "requester": {
      "$ref": "#/$defs/Ref",
      "x-to": [
        "person"
      ],
      "description": "often the product's own end user"
    },
    "organization": {
      "$ref": "#/$defs/Ref",
      "x-to": [
        "organization"
      ]
    },
    "assignee": {
      "$ref": "#/$defs/Ref",
      "x-to": [
        "member"
      ]
    },
    "team": {
      "$ref": "#/$defs/Ref",
      "x-to": [
        "team"
      ]
    },
    "status": {
      "$ref": "#/$defs/Status",
      "x-categories": [
        "new",
        "open",
        "pending",
        "on_hold",
        "solved",
        "closed"
      ],
      "default": {
        "category": "new"
      }
    },
    "priority": {
      "type": "string",
      "enum": [
        "urgent",
        "high",
        "normal",
        "low"
      ]
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "chat",
        "sms",
        "phone",
        "web",
        "social",
        "api",
        "other"
      ]
    },
    "due_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time",
      "description": "first time status became solved or closed"
    },
    "about": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Ref"
      }
    }
  },
  "required": [
    "id",
    "model",
    "workspace",
    "revision",
    "created_at",
    "updated_at",
    "created_by",
    "updated_by",
    "subject",
    "requester",
    "status"
  ],
  "additionalProperties": false,
  "x-model": {
    "name": "ticket",
    "version": 1,
    "group": "support",
    "identity": [
      [
        "identifiers"
      ]
    ],
    "status_categories": [
      "new",
      "open",
      "pending",
      "on_hold",
      "solved",
      "closed"
    ],
    "sensitivity": {},
    "events": [
      {
        "field": "status.category",
        "to": "solved",
        "name": "ticket.solved"
      },
      {
        "field": "status.category",
        "to": "closed",
        "name": "ticket.closed"
      }
    ],
    "agent_context": "Ticket is the request; what was said is Messages with about [ticket], and what the team thinks is Notes about it.\nAssignment and status changes are the audit log, not records. The requester is a Person, often an end user of the\nproduct. Dedupe by the source system's id in identifiers, so search open Tickets from the same requester before\ncreating one. The one mistake: solved without a Message to the requester; solved emits ticket.solved."
  },
  "$defs": {
    "Ref": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "model",
        "id"
      ],
      "additionalProperties": false
    },
    "Principal": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "member",
            "person",
            "share",
            "system"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    "Identifier": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "maxLength": 4000
        },
        "value": {
          "type": "string",
          "maxLength": 4000
        },
        "primary": {
          "type": "boolean"
        }
      },
      "required": [
        "system",
        "value"
      ],
      "additionalProperties": false,
      "description": "An external or natural key. `system` is a registered scheme (email, domain, vat:eu, sha256, stripe:customer, postware:workspace)."
    },
    "Status": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "maxLength": 4000
        },
        "state": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "category"
      ],
      "additionalProperties": false,
      "description": "category is the standard (validated per model); state is the workspace's own label."
    }
  }
}