{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:postware:core:product",
  "title": "Product",
  "description": "A thing the business sells or buys: a good, a service or a digital item. What it costs lives on a Price in the Billing pack.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID; generated when absent"
    },
    "model": {
      "type": "string",
      "description": "name@version",
      "readOnly": true
    },
    "workspace": {
      "type": "string",
      "description": "the Workspace record id",
      "readOnly": true
    },
    "revision": {
      "type": "integer",
      "description": "optimistic concurrency with If-Match",
      "readOnly": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "created_by": {
      "$ref": "#/$defs/Principal",
      "description": "{kind: member|person|share|system, id}",
      "readOnly": true
    },
    "updated_by": {
      "$ref": "#/$defs/Principal",
      "description": "{kind, id}",
      "readOnly": true
    },
    "owner": {
      "type": "string",
      "description": "Member id, the accountable operator"
    },
    "identifiers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Identifier"
      },
      "description": "Identifier[]: the crosswalk"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z0-9][a-z0-9_-]{0,63}:)?[a-z0-9][a-z0-9_-]{0,63}(/[a-z0-9][a-z0-9_-]{0,63})*$"
      },
      "description": "tag slugs, `namespace:slug` form"
    },
    "ext": {
      "type": "object",
      "description": "declared extensions only"
    },
    "source": {
      "type": "object",
      "description": "{system, external_id, created_at, updated_at, deleted_at?, import_run, imported_at, payload}"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "soft delete",
      "readOnly": true
    },
    "name": {
      "type": "string",
      "maxLength": 4000
    },
    "description": {
      "type": "string",
      "contentMediaType": "text/markdown"
    },
    "kind": {
      "type": "string",
      "enum": [
        "good",
        "service",
        "digital"
      ]
    },
    "unit": {
      "type": "string",
      "maxLength": 4000,
      "description": "default unit of measure for invoice lines: a UN/ECE Rec 20 code (C62, HUR) or a word (seat, hour)"
    },
    "tax_rate": {
      "$ref": "#/$defs/Ref",
      "x-to": [
        "tax_rate"
      ],
      "description": "the default tax rate for lines of this product"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "id",
    "model",
    "workspace",
    "revision",
    "created_at",
    "updated_at",
    "created_by",
    "updated_by",
    "name",
    "active"
  ],
  "additionalProperties": false,
  "x-model": {
    "name": "product",
    "version": 1,
    "group": "core",
    "identity": [
      [
        "identifiers"
      ]
    ],
    "status_categories": [],
    "sensitivity": {},
    "events": null,
    "agent_context": "One Product per sellable thing, never one per price: the amount, currency and billing interval live on Prices\nthat reference it, and a plan billed monthly and yearly is one Product with two Prices. Dedupe by the sku\nidentifier (system sku). Inventory counts, purchase cost and ledger accounts are extensions. The one mistake:\ndeleting a Product that Invoices or Subscriptions reference; set active to false instead."
  },
  "$defs": {
    "Ref": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "model",
        "id"
      ],
      "additionalProperties": false
    },
    "Principal": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "member",
            "person",
            "share",
            "system"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    "Identifier": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "maxLength": 4000
        },
        "value": {
          "type": "string",
          "maxLength": 4000
        },
        "primary": {
          "type": "boolean"
        }
      },
      "required": [
        "system",
        "value"
      ],
      "additionalProperties": false,
      "description": "An external or natural key. `system` is a registered scheme (email, domain, vat:eu, sha256, stripe:customer, postware:workspace)."
    }
  }
}