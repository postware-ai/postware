{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:postware:billing:subscription",
  "title": "Subscription",
  "description": "A recurring agreement to bill (receivable) or be billed (payable) for Prices, period after period. Each period's charge is an Invoice that points back at it.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID; generated when absent"
    },
    "model": {
      "type": "string",
      "description": "name@version",
      "readOnly": true
    },
    "workspace": {
      "type": "string",
      "description": "the Workspace record id",
      "readOnly": true
    },
    "revision": {
      "type": "integer",
      "description": "optimistic concurrency with If-Match",
      "readOnly": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "created_by": {
      "$ref": "#/$defs/Principal",
      "description": "{kind: member|person|share|system, id}",
      "readOnly": true
    },
    "updated_by": {
      "$ref": "#/$defs/Principal",
      "description": "{kind, id}",
      "readOnly": true
    },
    "owner": {
      "type": "string",
      "description": "Member id, the accountable operator"
    },
    "identifiers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Identifier"
      },
      "description": "Identifier[]: the crosswalk"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z0-9][a-z0-9_-]{0,63}:)?[a-z0-9][a-z0-9_-]{0,63}(/[a-z0-9][a-z0-9_-]{0,63})*$"
      },
      "description": "tag slugs, `namespace:slug` form"
    },
    "ext": {
      "type": "object",
      "description": "declared extensions only"
    },
    "source": {
      "type": "object",
      "description": "{system, external_id, created_at, updated_at, deleted_at?, import_run, imported_at, payload}"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "soft delete",
      "readOnly": true
    },
    "direction": {
      "type": "string",
      "enum": [
        "receivable",
        "payable"
      ],
      "description": "receivable = our customer; payable = a vendor we pay",
      "default": "receivable"
    },
    "counterparty": {
      "$ref": "#/$defs/Ref",
      "x-to": [
        "organization",
        "person"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "price": {
            "$ref": "#/$defs/Ref",
            "x-to": [
              "price"
            ]
          },
          "quantity": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
            "default": "1"
          }
        },
        "required": [
          "price",
          "quantity"
        ],
        "additionalProperties": false
      }
    },
    "status": {
      "$ref": "#/$defs/Status",
      "x-categories": [
        "pending",
        "trialing",
        "active",
        "past_due",
        "paused",
        "cancelled"
      ]
    },
    "current_period": {
      "$ref": "#/$defs/Period",
      "description": "the period being billed now; absent while pending"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "trial_end": {
      "type": "string",
      "format": "date-time"
    },
    "cancel_at": {
      "type": "string",
      "format": "date-time",
      "description": "scheduled end; when set the subscription does not renew"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "reference": {
      "type": "string",
      "maxLength": 4000,
      "description": "the customer's PO or reference, copied onto generated invoices"
    }
  },
  "required": [
    "id",
    "model",
    "workspace",
    "revision",
    "created_at",
    "updated_at",
    "created_by",
    "updated_by",
    "direction",
    "counterparty",
    "items",
    "status"
  ],
  "additionalProperties": false,
  "x-model": {
    "name": "subscription",
    "version": 1,
    "group": "billing",
    "identity": [
      [
        "identifiers"
      ]
    ],
    "status_categories": [
      "pending",
      "trialing",
      "active",
      "past_due",
      "paused",
      "cancelled"
    ],
    "sensitivity": {},
    "events": [
      {
        "field": "status.category",
        "to": "cancelled",
        "name": "subscription.cancelled"
      },
      {
        "field": "status.category",
        "to": "active",
        "name": "subscription.activated"
      },
      {
        "field": "status.category",
        "to": "past_due",
        "name": "subscription.past_due"
      }
    ],
    "agent_context": "Subscription is the recurring relationship; each period's charge is an Invoice that references it. status pending\nmeans it exists but has not started, so current_period and started_at are absent; cancel_at set means it will\nnot renew; ended_at is when it stopped. Dedupe by identifier (the billing provider's subscription id). The one\nmistake: cancelled without ended_at and cancel_at; the dates are what the status means."
  },
  "$defs": {
    "Ref": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "model",
        "id"
      ],
      "additionalProperties": false
    },
    "Principal": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "member",
            "person",
            "share",
            "system"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    "Identifier": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "maxLength": 4000
        },
        "value": {
          "type": "string",
          "maxLength": 4000
        },
        "primary": {
          "type": "boolean"
        }
      },
      "required": [
        "system",
        "value"
      ],
      "additionalProperties": false,
      "description": "An external or natural key. `system` is a registered scheme (email, domain, vat:eu, sha256, stripe:customer, postware:workspace)."
    },
    "Period": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "start"
      ],
      "additionalProperties": false
    },
    "Status": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "maxLength": 4000
        },
        "state": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "category"
      ],
      "additionalProperties": false,
      "description": "category is the standard (validated per model); state is the workspace's own label."
    }
  }
}