{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:postware:core:file",
  "title": "File",
  "description": "Stored or referenced binary content with a name and a type. The bytes live in object storage or on disk; the record holds the name, type, size and location.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID; generated when absent"
    },
    "model": {
      "type": "string",
      "description": "name@version",
      "readOnly": true
    },
    "workspace": {
      "type": "string",
      "description": "the Workspace record id",
      "readOnly": true
    },
    "revision": {
      "type": "integer",
      "description": "optimistic concurrency with If-Match",
      "readOnly": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "created_by": {
      "$ref": "#/$defs/Principal",
      "description": "{kind: member|person|share|system, id}",
      "readOnly": true
    },
    "updated_by": {
      "$ref": "#/$defs/Principal",
      "description": "{kind, id}",
      "readOnly": true
    },
    "owner": {
      "type": "string",
      "description": "Member id, the accountable operator"
    },
    "identifiers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Identifier"
      },
      "description": "Identifier[]: the crosswalk"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z0-9][a-z0-9_-]{0,63}:)?[a-z0-9][a-z0-9_-]{0,63}(/[a-z0-9][a-z0-9_-]{0,63})*$"
      },
      "description": "tag slugs, `namespace:slug` form"
    },
    "ext": {
      "type": "object",
      "description": "declared extensions only"
    },
    "source": {
      "type": "object",
      "description": "{system, external_id, created_at, updated_at, deleted_at?, import_run, imported_at, payload}"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "soft delete",
      "readOnly": true
    },
    "name": {
      "type": "string",
      "maxLength": 4000
    },
    "mime_type": {
      "type": "string",
      "maxLength": 4000,
      "description": "detected by the server; importers fall back to the extension or application/octet-stream"
    },
    "size": {
      "type": "integer",
      "description": "bytes; absent for native cloud documents"
    },
    "storage": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "maxLength": 4000,
          "description": "local, s3, or a source system"
        },
        "key": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "provider",
        "key"
      ],
      "additionalProperties": false
    },
    "about": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Ref"
      }
    }
  },
  "required": [
    "id",
    "model",
    "workspace",
    "revision",
    "created_at",
    "updated_at",
    "created_by",
    "updated_by",
    "name",
    "mime_type",
    "storage"
  ],
  "additionalProperties": false,
  "x-model": {
    "name": "file",
    "version": 1,
    "group": "core",
    "identity": [
      [
        "identifiers"
      ]
    ],
    "status_categories": [],
    "sensitivity": {},
    "events": null,
    "agent_context": "Create a File through the upload flow (upload-url, then complete), not by hand, so the storage key and the sha256\nidentifier are right. Dedupe by identifier: the server adds {system: sha256} for stored bytes; sources may add\nmd5, sha1, crc32, quickxor or dropbox:content-hash, and \u003csource\u003e:file for their own ids. The one mistake: a URL to\nan external file stored as a File; a File is bytes the workspace holds or a source system stores."
  },
  "$defs": {
    "Ref": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "model",
        "id"
      ],
      "additionalProperties": false
    },
    "Principal": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "member",
            "person",
            "share",
            "system"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    "Identifier": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "maxLength": 4000
        },
        "value": {
          "type": "string",
          "maxLength": 4000
        },
        "primary": {
          "type": "boolean"
        }
      },
      "required": [
        "system",
        "value"
      ],
      "additionalProperties": false,
      "description": "An external or natural key. `system` is a registered scheme (email, domain, vat:eu, sha256, stripe:customer, postware:workspace)."
    }
  }
}